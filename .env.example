# ============================================
# Santé — Voice Biomarker Platform
# ============================================

# OpenAI API Key (required for realtime voice agent)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# RunPod API Key (required for stress detection agent)
RUNPOD_API_KEY=your_runpod_api_key_here

# ── Twilio (phone calls + SMS) ───────────────
# Account SID from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token from https://console.twilio.com
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number in E.164 format
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Backend public URL ───────────────────────
# Publicly reachable URL of this FastAPI server.
# Used to build the WebSocket URL in TwiML and PDF report links in SMS.
# Local dev: use ngrok (e.g. https://abc123.ngrok.io)
# Production: your deployed domain
BACKEND_BASE_URL=https://your-ngrok-or-domain.example.com

# ── Redis ────────────────────────────────────
# Redis connection URL for the rq job queue
REDIS_URL=redis://localhost:6379/0

# ── Action forwarding MVP ───────────────────
# Enables autonomous clinician alerting when risk threshold is met.
ACTION_FORWARD_ENABLED=true
ACTION_FORWARD_THRESHOLD=70
ACTION_FORWARD_MIN_QUALITY_GRADE=C
ACTION_FORWARD_ALLOWLIST=+1xxxxxxxxxx

# Twilio phone-flow default forwarding behavior
ACTION_FORWARD_TWILIO_OPT_IN=true
ACTION_FORWARD_DEFAULT_RECIPIENT=+1xxxxxxxxxx

# Optional frontend/web-flow forwarding defaults
NEXT_PUBLIC_ACTION_FORWARD_OPT_IN=true
NEXT_PUBLIC_ACTION_FORWARD_RECIPIENT=+1xxxxxxxxxx
