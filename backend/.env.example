# Core
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_BASE_URL=http://127.0.0.1:8000

# OpenAI
OPENAI_API_KEY=

# RunPod
RUNPOD_API_KEY=
RUNPOD_STRESS_ENDPOINT_ID=bfl4ave2lkfph1
RUNPOD_PHONEME_ENDPOINT_ID=eib51lbk8ca3wl

# Redis / rq
REDIS_URL=redis://localhost:6379/0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Forwarding policy
ACTION_FORWARD_ENABLED=false
ACTION_FORWARD_ALLOWLIST=
ACTION_FORWARD_THRESHOLD=70
ACTION_FORWARD_MIN_QUALITY_GRADE=C
ACTION_FORWARD_TWILIO_OPT_IN=false
ACTION_FORWARD_DEFAULT_RECIPIENT=

# Safety triage
SAFETY_AGENT_ENABLED=true
SAFETY_KEYWORDS_HARD_STOP=suicide,kill myself,end my life,hurt myself
SAFETY_URGENT_CONFIDENCE_THRESHOLD=0.65
SAFETY_LLM_AGENT_ENABLED=true
SAFETY_LLM_MODEL=gpt-4o-mini
SAFETY_LLM_MAX_TRANSCRIPT_CHARS=2500
SAFETY_LLM_TIMEOUT_SECONDS=8
SAFETY_LLM_URGENT_CONFIDENCE_THRESHOLD=0.85
SAFETY_LLM_CONCERN_CONFIDENCE_THRESHOLD=0.60

